{
  "name": "trend-analyzer",
  "private": true,
  "scripts": {
    "install-all": "npm install && npm install --prefix frontend",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev --prefix frontend\"",
    "dev:api": ".venv/bin/python -m uvicorn trend_analyzer.server:app --reload --host 127.0.0.1 --port 8765",
    "build": "npm run build --prefix frontend",
    "preview": "npm run preview --prefix frontend",
    "start": ".venv/bin/python -m uvicorn trend_analyzer.server:app --host 127.0.0.1 --port 8765"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
